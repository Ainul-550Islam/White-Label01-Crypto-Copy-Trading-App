# Production-only values required by packages/config/src/env.schema.ts and the Compose deployment overlays.
# Copy to .env, provide every blank secret through a secret manager, and never commit the populated file.
# Generate each secret independently with a cryptographically secure random generator.

# Private registry prefix for the eight versioned service images.
REGISTRY=
# Immutable release tag shared by every deployed image; never use latest or main.
IMAGE_TAG=
# Previous immutable release tag used by scripts/deploy-single-vm.sh to roll back.
PREVIOUS_IMAGE_TAG=
# Public root domain with DNS records for api, app, and admin subdomains.
DOMAIN=
# Operations mailbox used by Caddy ACME certificate registration.
ACME_EMAIL=

# PostgreSQL owner account used only for initialization and Prisma migrations.
POSTGRES_USER=wlct
# Secret password for the PostgreSQL owner and one-shot migration job.
POSTGRES_PASSWORD=
# Separate least-privilege application role password; set it before first database boot.
POSTGRES_APP_PASSWORD=
# PostgreSQL database name consumed by Compose.
POSTGRES_DB=wlct
# Host-local PostgreSQL port; the production overlay removes the published port.
POSTGRES_PORT=5432
# Redis AUTH password required by the Compose Redis service.
REDIS_PASSWORD=

# Authenticated admin web session signing secret; keep distinct from the customer web secret.
SESSION_COOKIE_SECRET=
# Authenticated customer web session signing secret; keep distinct from the admin secret.
WEB_SESSION_COOKIE_SECRET=
# Shared API root environment mode required by the production Zod schema.
NODE_ENV=production
# Required Prisma runtime connection string; Compose replaces it with the private service DSN.
DATABASE_URL=
# Required 32-byte AES-256 key encoded as Base64; inject from a secret manager.
ENCRYPTION_MASTER_KEY_BASE64=
# Required blind-index HMAC key of at least 32 bytes, encoded as Base64.
BLIND_INDEX_KEY_BASE64=
# HMAC access-token signing secret; use at least 32 random characters and never reuse the refresh secret.
JWT_ACCESS_SECRET=
# HMAC refresh-token signing secret; use at least 32 random characters and keep it distinct.
JWT_REFRESH_SECRET=
# Shared internal service authentication secret, at least 16 characters.
INTERNAL_SERVICE_TOKEN=
# Exchange webhook signature secret, at least 16 characters.
EXCHANGE_WEBHOOK_SIGNING_SECRET=
# Authenticated metrics endpoint bearer token, at least 16 characters.
METRICS_TOKEN=
# AWS region used by AWS SDK-backed integrations.
AWS_REGION=us-east-1
# Keyed developer credential and webhook digests; use at least 32 random characters.
DEVELOPER_SECRET_HMAC_KEY=
# Execution-engine shared token; use at least 32 random characters.
EXECUTION_INTERNAL_TOKEN=

# Select the symmetric JWT key mode used by the two required secret values above.
JWT_ALGORITHM=HS256
# Disable Swagger in production unless a separate basic-auth password is explicitly configured.
SWAGGER_ENABLED=false
# Keep real-money execution disabled until an independently approved production change.
EXECUTION_ENABLED=false
# Keep venue traffic on sandbox endpoints until explicitly reviewed and approved.
EXCHANGE_SANDBOX_MODE=true
# Keep execution in dry-run mode by default.
DRY_RUN=true
# Do not enable live trading during first boot.
LIVE_TRADING_ENABLED=false
# Keep paper trading enabled for the default execution posture.
PAPER_TRADING=true
# Use the non-live simulated execution mode.
EXECUTION_MODE=simulated
# Enable the production risk engine; the schema refuses production boot when disabled.
RISK_ENGINE_ENABLED=true
# Enable production operations and health observability as required by the schema.
OBSERVABILITY_ENABLED=true
# Keep authenticated metrics enabled in production.
METRICS_ENABLED=true
# Keep health and readiness checks enabled in production.
HEALTH_ENABLED=true
# Keep Prometheus exposition enabled in production.
PROMETHEUS_ENABLED=true
# Keep durable production alerting enabled.
ALERTING_ENABLED=true
# Use an absolute path for production dataset storage.
DATASET_LOCAL_ROOT=/var/lib/wlct/datasets
# Use a separate absolute path for production dataset staging.
DATASET_TEMP_ROOT=/var/lib/wlct/staging
# Bound sensitive-operation step-up proofs to the configured 60–900 second window.
STEP_UP_TTL_SECONDS=300
# Resolve the API through the internal Compose network from the web containers.
API_PUBLIC_URL=https://api.example.com
# Resolve the admin UI through its public TLS hostname.
ADMIN_WEB_URL=https://admin.example.com
# Allow only the public TLS origins used by this production deployment.
CORS_ORIGINS=https://app.example.com,https://admin.example.com
