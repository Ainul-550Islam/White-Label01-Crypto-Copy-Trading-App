{
  "name": "@wlct/web",
  "version": "1.0.0",
  "private": true,
  "description": "Customer-facing multi-tenant SaaS web application with white-label runtime",
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "dev:e2e": "next dev -p 3101 -H 127.0.0.1",
    "postbuild": "node scripts/check-tailwind-output.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@wlct/shared-types": "1.0.0",
    "@wlct/utils": "1.0.0",
    "@wlct/validation": "1.0.0",
    "jose": "^5.9.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.5.4"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": "\\.test\\.tsx?$",
    "moduleNameMapper": {
      "^@wlct/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts",
      "^@wlct/validation$": "<rootDir>/../../../packages/validation/src/index.ts",
      "^@/(.*)$": "<rootDir>/$1",
      "^@wlct/utils/api-error$": "<rootDir>/../../../packages/utils/src/api-error.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "jsx": "react-jsx"
          }
        }
      ]
    }
  }
}
