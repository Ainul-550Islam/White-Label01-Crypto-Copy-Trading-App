# Minimal local-development environment for the API + customer web + admin web.
# Copy this file to the repository root as .env, then run:
#   docker compose up --build api web admin-web
# Compose will also start the API's PostgreSQL, Redis, and migration dependencies.
# This limited service set does not start the dedicated worker, trading engine,
# market-data service, notification service, or execution engine.
#
# Contains 36 active variables. Values labelled local-development-only are
# placeholders for a disposable local environment; never reuse them in staging
# or production. Replace them with freshly generated secrets before any shared
# or externally reachable deployment.

# Runtime and published ports
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
ADMIN_WEB_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api
ADMIN_WEB_PORT=3000
WEB_PORT=3001

# Local PostgreSQL and Redis; Compose publishes both on loopback in development.
POSTGRES_USER=copytrade
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=copytrade
POSTGRES_PORT=5432
DATABASE_URL=postgresql://copytrade:change_me_postgres_password@localhost:5432/copytrade?schema=public
DIRECT_DATABASE_URL=postgresql://copytrade:change_me_postgres_password@localhost:5432/copytrade?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

# Required API credentials: development-only placeholders; replace for any shared use.
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
ENCRYPTION_MASTER_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BLIND_INDEX_KEY_BASE64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
INTERNAL_SERVICE_TOKEN=change_me_internal_service_token
EXCHANGE_WEBHOOK_SIGNING_SECRET=change_me_webhook_secret

# Explicit non-live paper mode. DRY_RUN must be false because it takes priority
# over PAPER_TRADING in AppConfigService. TRADING_MODE/TRADING_ENABLED are the
# separate trading-core resolver inputs; both API and trading-core resolve PAPER.
EXECUTION_ENABLED=true
DRY_RUN=false
PAPER_TRADING=true
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false
EXCHANGE_SANDBOX_MODE=true
TRADING_MODE=PAPER
TRADING_ENABLED=true

# Distinct cookie-signing keys for the operator console and customer web app.
SESSION_COOKIE_SECRET=change_me_admin_session_secret_min_16_chars
WEB_SESSION_COOKIE_SECRET=change_me_web_session_secret_min_16_chars

# Keep API background work inline only when the dedicated worker is not started.
QUEUE_RUN_INLINE_WORKERS=true
ADMIN_TENANT_SLUG=platform
